[
 {
  "s": "erzaehler",
  "k": "98609025e28280d847f4",
  "text": "Acht"
 },
 {
  "s": "erzaehler",
  "k": "9067cedc256dbce53d29",
  "text": "Acht."
 },
 {
  "s": "erzaehler",
  "k": "4b8d5ff30e12821fc4d2",
  "text": "Alle tanzen um den großen Pilz."
 },
 {
  "s": "erzaehler",
  "k": "0fe319b881e038b22cf6",
  "text": "Bei fünf sind die Augen der Eule ganz schwer."
 },
 {
  "s": "erzaehler",
  "k": "9f621f3a4f4b652fa49c",
  "text": "Blaubeeren gezählt."
 },
 {
  "s": "erzaehler",
  "k": "018677ad394de7db8416",
  "text": "Blaubeeren!"
 },
 {
  "s": "erzaehler",
  "k": "841412c1c9c73311a9f9",
  "text": "Blaubeeren."
 },
 {
  "s": "erzaehler",
  "k": "8a8ccab4e169f4cfa6ad",
  "text": "Blubb, blubb!"
 },
 {
  "s": "erzaehler",
  "k": "6968f692bd2bed450367",
  "text": "Blumen gezählt."
 },
 {
  "s": "erzaehler",
  "k": "38273ce2f2141e2e41cd",
  "text": "Blumen!"
 },
 {
  "s": "erzaehler",
  "k": "17b4a8a82572c10a94de",
  "text": "Blumen."
 },
 {
  "s": "erzaehler",
  "k": "6b152e8fe14bfeeb025f",
  "text": "BluppBlupp hat eine Idee."
 },
 {
  "s": "erzaehler",
  "k": "0f6935d849f65d5247bd",
  "text": "BluppBlupp hüpft vor Freude."
 },
 {
  "s": "erzaehler",
  "k": "de205894c75565ee3f1b",
  "text": "BluppBlupp mag Regen – er ist ja ein Nilpferd!"
 },
 {
  "s": "erzaehler",
  "k": "08df1b2d422afd172b42",
  "text": "BluppBlupp und Herr Zinn hören sie: Huhu, huhu!"
 },
 {
  "s": "erzaehler",
  "k": "c71a8b03d9c921f8381b",
  "text": "BluppBlupp und die verlorene Laterne"
 },
 {
  "s": "erzaehler",
  "k": "b8f874af7062beba7023",
  "text": "BluppBlupp wackelt mit den Ohren."
 },
 {
  "s": "erzaehler",
  "k": "f7e5ea5da4c24daeb82d",
  "text": "BluppBlupp, das blaue Nilpferd, gähnt ganz laut."
 },
 {
  "s": "erzaehler",
  "k": "7c38602e1b67eeed1cce",
  "text": "Blätter gezählt."
 },
 {
  "s": "erzaehler",
  "k": "fbbbb3907f27a627209c",
  "text": "Blätter!"
 },
 {
  "s": "erzaehler",
  "k": "b0d5f3718976e784fd9c",
  "text": "Blätter."
 },
 {
  "s": "erzaehler",
  "k": "0cd657f37268a7a6cea5",
  "text": "Buchstaben"
 },
 {
  "s": "erzaehler",
  "k": "cb25876686a011d21b4f",
  "text": "Buchstaben kommt bald!"
 },
 {
  "s": "erzaehler",
  "k": "f632c2fedc3a495a0e02",
  "text": "Da ist gar nichts!"
 },
 {
  "s": "erzaehler",
  "k": "dbc2301adcaccab2cb1c",
  "text": "Da kommt Onkel Zinn."
 },
 {
  "s": "erzaehler",
  "k": "639b2077d9d267e33b08",
  "text": "Dann kommt die Sonne."
 },
 {
  "s": "erzaehler",
  "k": "9769187e27f5d6280aaf",
  "text": "Das Feld ist leer."
 },
 {
  "s": "erzaehler",
  "k": "6368a15992a861facf72",
  "text": "Das ist BluppBlupp, das blaue Nilpferd."
 },
 {
  "s": "erzaehler",
  "k": "771aa9bf0669f4525f1b",
  "text": "Das ist Herr Zinn, BluppBlupps Onkel mit der Laterne."
 },
 {
  "s": "erzaehler",
  "k": "f45db1b47e2ef19be1e6",
  "text": "Das ist die"
 },
 {
  "s": "erzaehler",
  "k": "d76c82271fd1c2e40a48",
  "text": "Das ist ein Einhorn!"
 },
 {
  "s": "erzaehler",
  "k": "5936eb112226cf970e24",
  "text": "Das ist ein Frosch!"
 },
 {
  "s": "erzaehler",
  "k": "0299d1ca50a96979c5f1",
  "text": "Das ist ein Igel!"
 },
 {
  "s": "erzaehler",
  "k": "1ceab128f4249a3b9ac4",
  "text": "Das ist ein Küken!"
 },
 {
  "s": "erzaehler",
  "k": "1a79c0bfa2f5a325ba4e",
  "text": "Das ist ein Schmetterling!"
 },
 {
  "s": "erzaehler",
  "k": "4d2464ef4b025fe5bbf9",
  "text": "Das ist ein kleiner, freundlicher Drache!"
 },
 {
  "s": "erzaehler",
  "k": "0fde5c1ec924dfc42edd",
  "text": "Das ist ein kleines blaues Nilpferd."
 },
 {
  "s": "erzaehler",
  "k": "07d3b1424dd18ba65516",
  "text": "Das ist eine Schildkröte!"
 },
 {
  "s": "erzaehler",
  "k": "8dca798364915ccf2e33",
  "text": "Das ist eine kleine Eule!"
 },
 {
  "s": "erzaehler",
  "k": "098f2e1261f0b5f4c928",
  "text": "Der Igel kommt, der Fuchs kommt, und das Eichhörnchen kommt auch."
 },
 {
  "s": "erzaehler",
  "k": "7bc48baeff1ced453c58",
  "text": "Der Regenbogen über dem See"
 },
 {
  "s": "erzaehler",
  "k": "97092b488bb64468230e",
  "text": "Die"
 },
 {
  "s": "erzaehler",
  "k": "82957609006109ebec3f",
  "text": "Die Eule kann nicht schlafen"
 },
 {
  "s": "erzaehler",
  "k": "660b93795c91ea1453a9",
  "text": "Die Glühwürmchen setzen sich in die Laterne."
 },
 {
  "s": "erzaehler",
  "k": "6ade4f746a9d2080416e",
  "text": "Die Pilz-Party"
 },
 {
  "s": "erzaehler",
  "k": "e1de0a27bb3300034450",
  "text": "Die kleine Eule hat Rätsel für dich!"
 },
 {
  "s": "erzaehler",
  "k": "0358711b9b89b745c672",
  "text": "Die wird mal ein Schmetterling."
 },
 {
  "s": "erzaehler",
  "k": "02f679ff518b80c22e72",
  "text": "Drei"
 },
 {
  "s": "erzaehler",
  "k": "666888e3d6996050b17f",
  "text": "Drei."
 },
 {
  "s": "erzaehler",
  "k": "09c50641a1531336fd86",
  "text": "Drück die Knöpfe, dann tanzt BluppBlupp!"
 },
 {
  "s": "erzaehler",
  "k": "d63bfbf11434a43be38d",
  "text": "Du bist ja so klug wie eine Eule!"
 },
 {
  "s": "erzaehler",
  "k": "52328aa3062dcf026bd4",
  "text": "Du hast"
 },
 {
  "s": "erzaehler",
  "k": "61e00afe540cfa64a930",
  "text": "Du hast die Schatzkiste erreicht!"
 },
 {
  "s": "erzaehler",
  "k": "cff68a167736b1128e15",
  "text": "Eichhörnchen gezählt."
 },
 {
  "s": "erzaehler",
  "k": "6387d588fb673e965b4e",
  "text": "Eichhörnchen!"
 },
 {
  "s": "erzaehler",
  "k": "f91ab6e2cf8d27bc0dc4",
  "text": "Eichhörnchen."
 },
 {
  "s": "erzaehler",
  "k": "15a0fa42c8a54426e435",
  "text": "Ein Blatt."
 },
 {
  "s": "erzaehler",
  "k": "b4adec5c73a5416a6127",
  "text": "Ein Eichhörnchen."
 },
 {
  "s": "erzaehler",
  "k": "0f1327515b6497d12ea5",
  "text": "Ein Frosch."
 },
 {
  "s": "erzaehler",
  "k": "696966cef888ecdfdbab",
  "text": "Ein Fuchs."
 },
 {
  "s": "erzaehler",
  "k": "74911113b12c7b3b6be2",
  "text": "Ein Igel."
 },
 {
  "s": "erzaehler",
  "k": "c519f792ab454fb4e17b",
  "text": "Ein Marienkäfer!"
 },
 {
  "s": "erzaehler",
  "k": "03799ee2dc66b9623740",
  "text": "Ein Marienkäfer."
 },
 {
  "s": "erzaehler",
  "k": "9e78db646db1108e08d0",
  "text": "Ein Pilz."
 },
 {
  "s": "erzaehler",
  "k": "4a6bd723822732f3ff3a",
  "text": "Ein Schmetterling."
 },
 {
  "s": "erzaehler",
  "k": "beaed1d7593fe60c7b32",
  "text": "Ein Stern."
 },
 {
  "s": "erzaehler",
  "k": "7d88e32d7d428cd93be4",
  "text": "Ein blaues Nilpferd."
 },
 {
  "s": "erzaehler",
  "k": "e78fc0287ceb07cc4a70",
  "text": "Ein kleiner Pilz!"
 },
 {
  "s": "erzaehler",
  "k": "0c686c7725f40a310b46",
  "text": "Eine Blaubeere."
 },
 {
  "s": "erzaehler",
  "k": "f86af950592f50b656a8",
  "text": "Eine Blume."
 },
 {
  "s": "erzaehler",
  "k": "9db958675edd559b1ed8",
  "text": "Eine Eule."
 },
 {
  "s": "erzaehler",
  "k": "04e93ba91978a19d2f3e",
  "text": "Eine Kastanie!"
 },
 {
  "s": "erzaehler",
  "k": "d20ee9492ea59c68d394",
  "text": "Eine Kastanie."
 },
 {
  "s": "erzaehler",
  "k": "a91a43f5b917e58fc2f0",
  "text": "Eine Raupe!"
 },
 {
  "s": "erzaehler",
  "k": "846540dad2ad0414c5c1",
  "text": "Eine Schnecke!"
 },
 {
  "s": "erzaehler",
  "k": "16274436c571fcd0c404",
  "text": "Eine Schnecke."
 },
 {
  "s": "erzaehler",
  "k": "e705e541a009a1436ae1",
  "text": "Eins"
 },
 {
  "s": "erzaehler",
  "k": "9d5c14c750dbbc09de55",
  "text": "Eins, zwei, drei!"
 },
 {
  "s": "erzaehler",
  "k": "af3757b08a52cdc4f4aa",
  "text": "Eins, zwei, drei, vier …"
 },
 {
  "s": "erzaehler",
  "k": "58e961e1ba085b27edb7",
  "text": "Eins."
 },
 {
  "s": "erzaehler",
  "k": "b31056f6ca79044930c8",
  "text": "Ende."
 },
 {
  "s": "erzaehler",
  "k": "3c12aa55c82d54686228",
  "text": "Entdecken"
 },
 {
  "s": "erzaehler",
  "k": "b0c8c92b291e23c82fae",
  "text": "Er krabbelt auf deinen Finger."
 },
 {
  "s": "erzaehler",
  "k": "5082bc7addbb54bee783",
  "text": "Er ruft leise: Glühwürmchen, kommt her!"
 },
 {
  "s": "erzaehler",
  "k": "8de56c627c2bf11e03a7",
  "text": "Er springt in eine große Pfütze."
 },
 {
  "s": "erzaehler",
  "k": "636935a4bb679cc4e627",
  "text": "Es regnet im Zauberwald."
 },
 {
  "s": "erzaehler",
  "k": "930510e5f9d05002f1ab",
  "text": "Es wird Abend im Zauberwald."
 },
 {
  "s": "erzaehler",
  "k": "4bfa2631b7d48be5f7f8",
  "text": "Eulen gezählt."
 },
 {
  "s": "erzaehler",
  "k": "14e18143fd776603cc3d",
  "text": "Eulen!"
 },
 {
  "s": "erzaehler",
  "k": "e459c7684c328d4d5c2c",
  "text": "Eulen."
 },
 {
  "s": "erzaehler",
  "k": "c3c2b6c2452143aca251",
  "text": "Farben und Formen"
 },
 {
  "s": "erzaehler",
  "k": "31836e0faa8d762b252a",
  "text": "Farben und Formen kommt bald!"
 },
 {
  "s": "erzaehler",
  "k": "34e5933429576559e83c",
  "text": "Finde die Zahl"
 },
 {
  "s": "erzaehler",
  "k": "175b6846aa030fbc43be",
  "text": "Frösche gezählt."
 },
 {
  "s": "erzaehler",
  "k": "f57502fedce081aa61a1",
  "text": "Frösche!"
 },
 {
  "s": "erzaehler",
  "k": "060f99b4932122fe52ce",
  "text": "Frösche."
 },
 {
  "s": "erzaehler",
  "k": "914e454b34dacfc214f9",
  "text": "Füchse gezählt."
 },
 {
  "s": "erzaehler",
  "k": "2a689ed1b4ee4e0f1411",
  "text": "Füchse!"
 },
 {
  "s": "erzaehler",
  "k": "f99108dc1305068fc389",
  "text": "Füchse."
 },
 {
  "s": "erzaehler",
  "k": "0acc366014085ad8f147",
  "text": "Fünf"
 },
 {
  "s": "erzaehler",
  "k": "e9caa952c8d143cdc929",
  "text": "Fünf."
 },
 {
  "s": "erzaehler",
  "k": "637e299eaa6c954264ad",
  "text": "Ganz genau!"
 },
 {
  "s": "erzaehler",
  "k": "204d002a1cda758899a1",
  "text": "Ganz genau, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "f2a39347f26d5dc82677",
  "text": "Ganz langsam kriecht sie weg."
 },
 {
  "s": "erzaehler",
  "k": "91b4e11335c4033e3542",
  "text": "Gute Nacht, Zauberwald."
 },
 {
  "s": "erzaehler",
  "k": "9961fc28485fa83bee5f",
  "text": "Herr Zinn bringt Blaubeeren, Erdbeeren und ein Glas Honig mit."
 },
 {
  "s": "erzaehler",
  "k": "de17ee660a5341b8a537",
  "text": "Herr Zinn hat ein Zauber-Ei gefunden."
 },
 {
  "s": "erzaehler",
  "k": "c96a7744842f2021006a",
  "text": "Herr Zinn sagt: Der Regenbogen hat sieben Farben."
 },
 {
  "s": "erzaehler",
  "k": "c54029b55b54fedebdb6",
  "text": "Herr Zinn zeigt in den Himmel: Wir zählen die Sterne."
 },
 {
  "s": "erzaehler",
  "k": "351965293bd0c3f587c8",
  "text": "Heute feiert der Zauberwald eine Pilz-Party."
 },
 {
  "s": "erzaehler",
  "k": "619d1392a3b12746bb4a",
  "text": "Hier sind"
 },
 {
  "s": "erzaehler",
  "k": "bf70146725ec6841d97a",
  "text": "Hm, das nicht."
 },
 {
  "s": "erzaehler",
  "k": "cc3a5d7197a510ce309f",
  "text": "Hmm."
 },
 {
  "s": "erzaehler",
  "k": "295696d2443c7c1b523b",
  "text": "Huhu!"
 },
 {
  "s": "erzaehler",
  "k": "e7be9b4c7ee9300b049a",
  "text": "Ich bin blau, rund und mache Blubb."
 },
 {
  "s": "erzaehler",
  "k": "9f7c1d332b22fb39ecbe",
  "text": "Ich habe Stacheln und rolle mich zusammen."
 },
 {
  "s": "erzaehler",
  "k": "67bf73aa2af1f74bf930",
  "text": "Ich rufe nachts Huhu."
 },
 {
  "s": "erzaehler",
  "k": "449a780d947d1f7e558c",
  "text": "Ich spreche"
 },
 {
  "s": "erzaehler",
  "k": "20c847b9983e7b448d95",
  "text": "Ich trage einen großen Hut und eine Laterne."
 },
 {
  "s": "erzaehler",
  "k": "c58babbe1e37b85323f5",
  "text": "Ich trage mein Haus auf dem Rücken."
 },
 {
  "s": "erzaehler",
  "k": "ef347367134be6914452",
  "text": "Igel gezählt."
 },
 {
  "s": "erzaehler",
  "k": "593f04edf16546957994",
  "text": "Igel!"
 },
 {
  "s": "erzaehler",
  "k": "ee3e9aac5d554aa865c7",
  "text": "Igel."
 },
 {
  "s": "erzaehler",
  "k": "90d38151a3117bab0144",
  "text": "Ja, genau!"
 },
 {
  "s": "erzaehler",
  "k": "5f7c9c5b639103685b56",
  "text": "Ja, genau, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "387cd48e37614e64751a",
  "text": "Jetzt ist er ganz nass und lacht."
 },
 {
  "s": "erzaehler",
  "k": "87adebe88b51b569025e",
  "text": "Jetzt ist es so dunkel."
 },
 {
  "s": "erzaehler",
  "k": "76aa4a3bc6fdc89468f9",
  "text": "Juhu!"
 },
 {
  "s": "erzaehler",
  "k": "3e4261d273cea6ee37d1",
  "text": "Juhu, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "f3ec53ba212041eeb4ed",
  "text": "Kastanien gezählt."
 },
 {
  "s": "erzaehler",
  "k": "874c4d21feffcb5bf81e",
  "text": "Kastanien!"
 },
 {
  "s": "erzaehler",
  "k": "f74749569fc6b057e235",
  "text": "Kastanien."
 },
 {
  "s": "erzaehler",
  "k": "a74ae4cbdd3e08a45ccf",
  "text": "Lass uns zusammen zählen!"
 },
 {
  "s": "erzaehler",
  "k": "a81b61927a090d3943bb",
  "text": "Marienkäfer gezählt."
 },
 {
  "s": "erzaehler",
  "k": "115993daf6f37548ce5e",
  "text": "Marienkäfer!"
 },
 {
  "s": "erzaehler",
  "k": "25a2e3aa53b9ac074068",
  "text": "Marienkäfer."
 },
 {
  "s": "erzaehler",
  "k": "24eb9a4d47940e7fb6b4",
  "text": "Mathe"
 },
 {
  "s": "erzaehler",
  "k": "2a829e59f4cf7a9559d9",
  "text": "Mathe kommt bald!"
 },
 {
  "s": "erzaehler",
  "k": "55d4aa3dbf276307f107",
  "text": "Mmmh!"
 },
 {
  "s": "erzaehler",
  "k": "7310b4015b9e79efb4ae",
  "text": "Nachts macht der Zauberwald Musik."
 },
 {
  "s": "erzaehler",
  "k": "c7a9c727bf9c2e0c076e",
  "text": "Neun"
 },
 {
  "s": "erzaehler",
  "k": "2cc1918401ef95df0fe4",
  "text": "Neun."
 },
 {
  "s": "erzaehler",
  "k": "2aca2c9090aeeb27dd21",
  "text": "Null"
 },
 {
  "s": "erzaehler",
  "k": "a678a078a59782c10df8",
  "text": "Null heißt: gar nichts!"
 },
 {
  "s": "erzaehler",
  "k": "bb56bc761bcb154ca177",
  "text": "Null."
 },
 {
  "s": "erzaehler",
  "k": "6508a78b37ad1cee8ca2",
  "text": "Oben im Baum sitzt eine kleine Eule."
 },
 {
  "s": "erzaehler",
  "k": "1d700d5dd1cd52582354",
  "text": "Oh je!"
 },
 {
  "s": "erzaehler",
  "k": "4699539725253b0c2820",
  "text": "Pilze gezählt."
 },
 {
  "s": "erzaehler",
  "k": "f8dfe50d1ef5fe71763f",
  "text": "Pilze!"
 },
 {
  "s": "erzaehler",
  "k": "569a08d59c347bde1d4d",
  "text": "Pilze."
 },
 {
  "s": "erzaehler",
  "k": "18d531ef11f9b734e5b7",
  "text": "Platsch!"
 },
 {
  "s": "erzaehler",
  "k": "eee4dfe4b271215e677f",
  "text": "Plitsch, platsch!"
 },
 {
  "s": "erzaehler",
  "k": "a0d39154efd35d78c068",
  "text": "Prima!"
 },
 {
  "s": "erzaehler",
  "k": "17f74350d6b30da0e207",
  "text": "Prima, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "905df38f71df3f8a585c",
  "text": "Psst!"
 },
 {
  "s": "erzaehler",
  "k": "6a896c50e8f19dda653f",
  "text": "Rechnen"
 },
 {
  "s": "erzaehler",
  "k": "4d1d2be275a90283c0a5",
  "text": "Richtig!"
 },
 {
  "s": "erzaehler",
  "k": "b6dea9a364f53bc40ec6",
  "text": "Richtig, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "a1ad070942bd215ba73e",
  "text": "Rot, orange, gelb, grün, blau, lila."
 },
 {
  "s": "erzaehler",
  "k": "42097e3f25549da3196b",
  "text": "Sag mal: Acht!"
 },
 {
  "s": "erzaehler",
  "k": "903b3b0b2b4f5b0877c8",
  "text": "Sag mal: Drei!"
 },
 {
  "s": "erzaehler",
  "k": "41dc711f53c22bf7546b",
  "text": "Sag mal: Eins!"
 },
 {
  "s": "erzaehler",
  "k": "2306e9c44b3b6eb715fc",
  "text": "Sag mal: Fünf!"
 },
 {
  "s": "erzaehler",
  "k": "989e96fc200fd9395e72",
  "text": "Sag mal: Neun!"
 },
 {
  "s": "erzaehler",
  "k": "ad16a321f3eebb279a3e",
  "text": "Sag mal: Null!"
 },
 {
  "s": "erzaehler",
  "k": "2a31c7852e0632084d77",
  "text": "Sag mal: Sechs!"
 },
 {
  "s": "erzaehler",
  "k": "9b498605e5a3413a9838",
  "text": "Sag mal: Sieben!"
 },
 {
  "s": "erzaehler",
  "k": "a9461dc7a1b075991ba6",
  "text": "Sag mal: Vier!"
 },
 {
  "s": "erzaehler",
  "k": "bb7cf2280d6165ce3cf9",
  "text": "Sag mal: Zehn!"
 },
 {
  "s": "erzaehler",
  "k": "b6784f1e0c478fd84fc2",
  "text": "Sag mal: Zwei!"
 },
 {
  "s": "erzaehler",
  "k": "68f36e7e495716386323",
  "text": "Schau mal, da ist gar nichts."
 },
 {
  "s": "erzaehler",
  "k": "701ec43187512bacd308",
  "text": "Schau mal, es bleibt gar nichts übrig!"
 },
 {
  "s": "erzaehler",
  "k": "1aa83fe02139666b26fc",
  "text": "Schmetterlinge gezählt."
 },
 {
  "s": "erzaehler",
  "k": "ad1f4c0150ebf7fb80fe",
  "text": "Schmetterlinge!"
 },
 {
  "s": "erzaehler",
  "k": "e568dc98901c5eef7595",
  "text": "Schmetterlinge."
 },
 {
  "s": "erzaehler",
  "k": "3c7dec48fc6c69df8202",
  "text": "Schnecken gezählt."
 },
 {
  "s": "erzaehler",
  "k": "36ac2ada665efac6d795",
  "text": "Schnecken!"
 },
 {
  "s": "erzaehler",
  "k": "c3cde3f2bfd36241182a",
  "text": "Schnecken."
 },
 {
  "s": "erzaehler",
  "k": "f9a7b44b3e3dbe8dd8df",
  "text": "Sechs"
 },
 {
  "s": "erzaehler",
  "k": "b76e077cb12bbfd27155",
  "text": "Sechs."
 },
 {
  "s": "erzaehler",
  "k": "4ff212085542bdd65e46",
  "text": "Sehr gut!"
 },
 {
  "s": "erzaehler",
  "k": "0e9a81f6e965b96b52b8",
  "text": "Sehr gut, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "d259ba6df13b806e4647",
  "text": "Sehr schön!"
 },
 {
  "s": "erzaehler",
  "k": "166ecf94f8f106e3d5b6",
  "text": "Sehr schön, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "9abe5fe172dde8acaa74",
  "text": "Seine Laterne ist ausgegangen."
 },
 {
  "s": "erzaehler",
  "k": "9ccd02f812def7a3fdc4",
  "text": "Sie kann nicht schlafen."
 },
 {
  "s": "erzaehler",
  "k": "f3426cd7efcfd4f8f858",
  "text": "Sie leuchtet warm und golden."
 },
 {
  "s": "erzaehler",
  "k": "373cf8eaa291ce267fa4",
  "text": "Sie schläft ein."
 },
 {
  "s": "erzaehler",
  "k": "922a1b98e68144138c75",
  "text": "Sieben"
 },
 {
  "s": "erzaehler",
  "k": "e17bcc9e54db90baaa43",
  "text": "Sieben."
 },
 {
  "s": "erzaehler",
  "k": "7d166c73208465db22ae",
  "text": "Sterne gezählt."
 },
 {
  "s": "erzaehler",
  "k": "97d87a85164a9a6051d3",
  "text": "Sterne!"
 },
 {
  "s": "erzaehler",
  "k": "b47c247374ca8b8ba9d9",
  "text": "Sterne."
 },
 {
  "s": "erzaehler",
  "k": "5d95dba838ba1e2bc710",
  "text": "Tipp ganz oft drauf!"
 },
 {
  "s": "erzaehler",
  "k": "debd0aed2e2671bdf2b5",
  "text": "Tipp sie an!"
 },
 {
  "s": "erzaehler",
  "k": "1b90fd0d83f8563faf67",
  "text": "Tippe alle Blaubeeren an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "4e9ebff2cdab82ab3d8f",
  "text": "Tippe alle Blumen an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "c2bab2972772cfd7588d",
  "text": "Tippe alle Blätter an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "bda9f255b2b7b2aba5bf",
  "text": "Tippe alle Eichhörnchen an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "0725cafb10774db6d0ee",
  "text": "Tippe alle Eulen an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "cee912ac083d01a2e1b7",
  "text": "Tippe alle Frösche an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "49b6947875b769e7665c",
  "text": "Tippe alle Füchse an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "f7db74eb56997b636ecb",
  "text": "Tippe alle Igel an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "e45d49f804a70540ed23",
  "text": "Tippe alle Kastanien an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "d69f47a2124c00193aaf",
  "text": "Tippe alle Marienkäfer an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "edc4477769da815a1566",
  "text": "Tippe alle Pilze an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "fffb548d5de0a2177e42",
  "text": "Tippe alle Schmetterlinge an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "2f97cbf0e7b32fc46d30",
  "text": "Tippe alle Schnecken an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "00beccc5928efc07a0ea",
  "text": "Tippe alle Sterne an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "c2fcde253011cd037afd",
  "text": "Tippe alle blaue Nilpferde an und zähl mit!"
 },
 {
  "s": "erzaehler",
  "k": "8921a2d09d5c1b148e32",
  "text": "Tippe auf eine Zahl!"
 },
 {
  "s": "erzaehler",
  "k": "21daabf9f7622bd2d814",
  "text": "Toll gemacht!"
 },
 {
  "s": "erzaehler",
  "k": "87194a1b3e951503f0a6",
  "text": "Toll gemacht, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "1854687883273b9a611f",
  "text": "Ton an"
 },
 {
  "s": "erzaehler",
  "k": "4695776a6c33a75de500",
  "text": "Uhrzeit"
 },
 {
  "s": "erzaehler",
  "k": "42ef9ef7c9d5306178c8",
  "text": "Uhrzeit kommt bald!"
 },
 {
  "s": "erzaehler",
  "k": "7c6818aac2c4ab0695a8",
  "text": "Und als die Sterne kommen, sind alle müde und froh."
 },
 {
  "s": "erzaehler",
  "k": "17ee51380916a836b167",
  "text": "Und noch ein Lila."
 },
 {
  "s": "erzaehler",
  "k": "c22e913207e01f0d04f7",
  "text": "Und schau mal: ein Regenbogen über dem See!"
 },
 {
  "s": "erzaehler",
  "k": "d0b70705e8a0b854dce5",
  "text": "Versuch es nochmal."
 },
 {
  "s": "erzaehler",
  "k": "0d73471675affbac38be",
  "text": "Vier"
 },
 {
  "s": "erzaehler",
  "k": "7c1d88fe44e90db4660a",
  "text": "Vier."
 },
 {
  "s": "erzaehler",
  "k": "02c07a654b84880e2c0c",
  "text": "Wackel, wackel!"
 },
 {
  "s": "erzaehler",
  "k": "1847a241bbb28a112183",
  "text": "Was fällt im Herbst von den Bäumen?"
 },
 {
  "s": "erzaehler",
  "k": "e86d6afb9f2f5513ed61",
  "text": "Was hat einen Hut, aber keinen Kopf?"
 },
 {
  "s": "erzaehler",
  "k": "e2878a26488f6f892eab",
  "text": "Was ist denn los?"
 },
 {
  "s": "erzaehler",
  "k": "bedb70af30c651463990",
  "text": "Was ist klein, blau und schmeckt süß?"
 },
 {
  "s": "erzaehler",
  "k": "72a50426be9cb7de6dbb",
  "text": "Was ist wohl darin?"
 },
 {
  "s": "erzaehler",
  "k": "13f6841d3a4221f81cce",
  "text": "Was leuchtet nachts am Himmel?"
 },
 {
  "s": "erzaehler",
  "k": "11f49315dbca1b8f360c",
  "text": "Welche Zahl ist das?"
 },
 {
  "s": "erzaehler",
  "k": "6119fa212cec0f06d2cf",
  "text": "Wer bin ich?"
 },
 {
  "s": "erzaehler",
  "k": "0e10e1ab3e6f74a4f193",
  "text": "Wer hat bunte Flügel und flattert von Blume zu Blume?"
 },
 {
  "s": "erzaehler",
  "k": "ad85b0aca38b3341e08a",
  "text": "Wer hat einen buschigen Schwanz und sammelt Nüsse?"
 },
 {
  "s": "erzaehler",
  "k": "29f4d91f841d14f8c3ed",
  "text": "Wer quakt am See?"
 },
 {
  "s": "erzaehler",
  "k": "e3a1c8cd2984a0e69c70",
  "text": "Wie BluppBlupp!"
 },
 {
  "s": "erzaehler",
  "k": "20c8d30a81fe4eb4d65f",
  "text": "Wie schön!"
 },
 {
  "s": "erzaehler",
  "k": "e05354fcdbd457089d0b",
  "text": "Wie viel ist"
 },
 {
  "s": "erzaehler",
  "k": "aa09c38116aef6173352",
  "text": "Wie viel ist gar nichts?"
 },
 {
  "s": "erzaehler",
  "k": "338b5be0bc5a54ac5117",
  "text": "Wie viele Blaubeeren siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "e865c2e07bac1c052b34",
  "text": "Wie viele Blumen siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "28a9ea5f7d77bdc41f7a",
  "text": "Wie viele Blätter siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "09bea108c6123c6e3f55",
  "text": "Wie viele Eichhörnchen siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "23315629152065ab7fcd",
  "text": "Wie viele Eulen siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "be1ed04e2590b53b460b",
  "text": "Wie viele Frösche siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "01075f44d4ae930425d3",
  "text": "Wie viele Füchse siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "a3db5575dede1470c049",
  "text": "Wie viele Igel siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "833afe1e3ea64d1c0702",
  "text": "Wie viele Kastanien siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "e3b93c66635947274597",
  "text": "Wie viele Marienkäfer siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "dd14f363f20ba4164248",
  "text": "Wie viele Pilze siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "ab6608b225df5c821767",
  "text": "Wie viele Schmetterlinge siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "d582572e3c18e928568d",
  "text": "Wie viele Schnecken siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "ff03f3bc205c6e15a4c7",
  "text": "Wie viele Sterne siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "5bda3cd03aab2a889790",
  "text": "Wie viele blaue Nilpferde siehst du?"
 },
 {
  "s": "erzaehler",
  "k": "2177dda4610dcc7c777a",
  "text": "Wie viele?"
 },
 {
  "s": "erzaehler",
  "k": "93cba818e3ea59445a32",
  "text": "Wo ist die"
 },
 {
  "s": "erzaehler",
  "k": "8c48f90e3252e59f18d1",
  "text": "Womit leuchtet Herr Zinn im Dunkeln?"
 },
 {
  "s": "erzaehler",
  "k": "1de2a3044c14348ec830",
  "text": "Wunderbar!"
 },
 {
  "s": "erzaehler",
  "k": "c945892c74b804630fa2",
  "text": "Wunderbar, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "a6d8aa833fe762368ba5",
  "text": "Zahlen von"
 },
 {
  "s": "erzaehler",
  "k": "345cf1a45713457311e0",
  "text": "Zauberhaft!"
 },
 {
  "s": "erzaehler",
  "k": "8f15cdf86d37ea4f64e8",
  "text": "Zauberhaft, Sam!"
 },
 {
  "s": "erzaehler",
  "k": "87d6b0c222cc4362d898",
  "text": "Zehn"
 },
 {
  "s": "erzaehler",
  "k": "a6fe2fb2f7ed465f2c69",
  "text": "Zehn."
 },
 {
  "s": "erzaehler",
  "k": "b1b4514bcf9b3b4a4e00",
  "text": "Zusammen gehen sie nach Hause."
 },
 {
  "s": "erzaehler",
  "k": "5f179a795eb979e4656c",
  "text": "Zwei"
 },
 {
  "s": "erzaehler",
  "k": "444fd6cc7b4ae82f97d5",
  "text": "Zwei."
 },
 {
  "s": "erzaehler",
  "k": "eb03576f73f2246cd43d",
  "text": "Zählen"
 },
 {
  "s": "erzaehler",
  "k": "f688802c63d84aea59f5",
  "text": "Zählst du mit?"
 },
 {
  "s": "erzaehler",
  "k": "0a2a7a2f097cb40eb318",
  "text": "bis"
 },
 {
  "s": "erzaehler",
  "k": "ff865228e9cdeb1c4dc6",
  "text": "blaue Nilpferde gezählt."
 },
 {
  "s": "erzaehler",
  "k": "d163e7d7a27dedb980d7",
  "text": "blaue Nilpferde!"
 },
 {
  "s": "erzaehler",
  "k": "bd1f28c89fa809c5c6b8",
  "text": "blaue Nilpferde."
 },
 {
  "s": "erzaehler",
  "k": "1c39f964aecc82aff10d",
  "text": "gehen weg."
 },
 {
  "s": "erzaehler",
  "k": "f16d222c2d28cd22460a",
  "text": "geht weg."
 },
 {
  "s": "erzaehler",
  "k": "96955924dce48b996428",
  "text": "ist"
 },
 {
  "s": "erzaehler",
  "k": "b6a2263ef9b9a6d3bfb0",
  "text": "minus"
 },
 {
  "s": "erzaehler",
  "k": "c600c274db25ee3c2c68",
  "text": "plus"
 },
 {
  "s": "zinn",
  "k": "62a4fd54727b3af66171",
  "text": "Ach herrje!"
 },
 {
  "s": "zinn",
  "k": "48d79b195d2f4801ba82",
  "text": "Ach herrje, Sam!"
 },
 {
  "s": "zinn",
  "k": "ac6aa2c188b702ca622c",
  "text": "Da ist er ja!"
 },
 {
  "s": "zinn",
  "k": "0bd258c5913ec14d2529",
  "text": "Danke dir!"
 },
 {
  "s": "zinn",
  "k": "8cf6ccf28a2a01b8cfb0",
  "text": "Danke!"
 },
 {
  "s": "zinn",
  "k": "777c6c49e1d33215d686",
  "text": "Danke, Sam!"
 },
 {
  "s": "zinn",
  "k": "57989bf3329c0382974d",
  "text": "Er liegt unter einem Moos-Hügel."
 },
 {
  "s": "zinn",
  "k": "e15cf10b39ed72220bc2",
  "text": "Es ist Nacht im Zauberwald."
 },
 {
  "s": "zinn",
  "k": "9e6962d018419174e22f",
  "text": "Fang die Glühwürmchen für meine Laterne!"
 },
 {
  "s": "zinn",
  "k": "3040f30e5e76ff92796f",
  "text": "Guten Tag!"
 },
 {
  "s": "zinn",
  "k": "fb399287b4e27a0ac4f7",
  "text": "Guten Tag, Sam!"
 },
 {
  "s": "zinn",
  "k": "cd3eca86a7bcc96a2d14",
  "text": "Hilfst du mir suchen?"
 },
 {
  "s": "zinn",
  "k": "815308bef954a69b0b51",
  "text": "Hilfst du mir?"
 },
 {
  "s": "zinn",
  "k": "7e811d92725cb33ab982",
  "text": "Ich bin Herr Zinn, der Onkel von BluppBlupp."
 },
 {
  "s": "zinn",
  "k": "dc1667ab478f43dc4aed",
  "text": "Ich bin Herr Zinn."
 },
 {
  "s": "zinn",
  "k": "98f4672122b5b0c9f99b",
  "text": "Ich habe meinen Zauberstein verloren."
 },
 {
  "s": "zinn",
  "k": "3a45f6abb8fa6c4ec952",
  "text": "Jetzt leuchtet meine Laterne wieder doppelt so hell."
 },
 {
  "s": "zinn",
  "k": "43c70b04ad6c7f998512",
  "text": "Komm mit in den Zauberwald."
 },
 {
  "s": "zinn",
  "k": "19ff189bf07f0e0c9a99",
  "text": "Mein Zauberstein!"
 },
 {
  "s": "zinn",
  "k": "7436821e3a06562a896a",
  "text": "Meine Laterne leuchtet uns den Weg."
 },
 {
  "s": "zinn",
  "k": "b59b8471fda3b91a1336",
  "text": "Schau mal, wie hell die Laterne jetzt leuchtet!"
 },
 {
  "s": "zinn",
  "k": "a20f6d035d7d0ee53710",
  "text": "Was möchtest du spielen?"
 },
 {
  "s": "blupp",
  "k": "25569b84c1c0cf7ccb04",
  "text": "Blubb!"
 },
 {
  "s": "blupp",
  "k": "4f0b7194961645518738",
  "text": "Blubb, blubb!"
 },
 {
  "s": "blupp",
  "k": "989642c31df7049479f2",
  "text": "Danke!"
 },
 {
  "s": "blupp",
  "k": "15bbabffd29f407400fb",
  "text": "Danke, Sam!"
 },
 {
  "s": "blupp",
  "k": "17ffd64c6518f749f6be",
  "text": "Das war schön!"
 },
 {
  "s": "blupp",
  "k": "26c6c1b65374c6490673",
  "text": "Hihi!"
 },
 {
  "s": "blupp",
  "k": "a30edf8fb567fcc315cb",
  "text": "Ich bin BluppBlupp, das blaue Nilpferd."
 },
 {
  "s": "blupp",
  "k": "673c311b1efad6c94d21",
  "text": "Ich hab so einen Hunger!"
 },
 {
  "s": "blupp",
  "k": "87d13e601ec212aaeb6f",
